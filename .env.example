# ── /api/lead serverless route configuration ──────────────────────────────
# Vercel (primary): set these in Project → Settings → Environment Variables.
# Cloudflare (alternate): set in Pages → Settings → Variables, or copy this to
# `.dev.vars` for `wrangler pages dev`.

# n8n webhook that receives both events (lead_captured, diagnostic_completed).
LEAD_WEBHOOK_URL=

# Email (optional). If unset, the report email is skipped silently.
# Provider: Resend (https://resend.com) — EMAIL_API_KEY is your Resend API key.
EMAIL_API_KEY=
EMAIL_FROM=diagnostics@storyadvantage.co

# Optional internal "new lead" alert address.
NOTIFY_EMAIL=

# CORS lock for /api/lead. Set to the exact origin the app is served from
# (e.g. https://diagnostic.storyadvantage.co). Leave unset to reflect the caller.
ALLOWED_ORIGIN=

# ── Supabase (stores completed results; enables the shareable /r/:id link) ──
# Project URL and the SERVICE ROLE key (server-only — never expose to the client).
# If unset, results simply aren't stored and no results link is added.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Base URL for building shareable result links in the email (e.g.
# https://diagnostic.storyadvantage.co). Defaults to the request origin if unset.
APP_URL=
